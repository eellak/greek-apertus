# Apertus-8B Greek CPT hyperparameters.
#
# Source this from scripts/train/train_apertus_cpt.sbatch. This file contains
# the model/training regime. Keep local/private paths in dataset_paths.env and
# cluster/resource choices in a launch profile such as
# configs/training/launch_profiles/clariden_16node_cxi.env.

# Local/deployment paths. Override these outside git.
APERTUS_BASE_HF="${APERTUS_BASE_HF:-}"
APERTUS_BASE_MEGATRON="${APERTUS_BASE_MEGATRON:-}"
MEGATRON_LM_DIR="${MEGATRON_LM_DIR:-}"
# Validated Swiss-AI Megatron-LM fork commit the patch/guard scripts target
# (AdEMAMix, Goldfish loss, xIELU/QK-Norm, the GPTDataset no-shuffle patch point).
# A new commit invalidates these targets; re-verify before changing.
MEGATRON_LM_COMMIT="${MEGATRON_LM_COMMIT:-c92402e39ef3c8e69ea378a59e79059dc14541f4}"

BASE_TOKENIZER_DIR="${BASE_TOKENIZER_DIR:-$APERTUS_BASE_HF}"
EXT_TOKENIZER_DIR="${EXT_TOKENIZER_DIR:-}"
BASE_DATA_PREFIX="${BASE_DATA_PREFIX:-}"
EXT_DATA_PREFIX="${EXT_DATA_PREFIX:-$BASE_DATA_PREFIX}"

# Optimizer: settled full-8B AdEMAMix values.
ADEMA_BETA1="0.9"
ADEMA_BETA2="${ADEMA_BETA2:-0.999}"
ADEMA_BETA3="${ADEMA_BETA3:-0.999}"
ADEMA_ALPHA="${ADEMA_ALPHA:-4.0}"
ADEMA_WEIGHT_DECAY="0.1"

# Initialization and learning rate.
INIT_STD="0.008944"
LR_PEAK="${LR_PEAK:-5.5e-5}"
LR_FINAL="${LR_FINAL:-5.5e-6}"
LR_SCHEDULE_STYLE="${LR_SCHEDULE_STYLE:-WSD}"
LR_WARMUP_INIT="${LR_WARMUP_INIT:-5.5e-6}"
LR_DECAY_STYLE="${LR_DECAY_STYLE:-1-sqrt}"

GRAD_CLIP="0.1"

# Batch/sequence.
SEQ_LENGTH="4096"
MICROBATCH_SIZE="2"
GLOBAL_BATCH_SIZE="1024"
GLOBAL_BATCH_TOKENS="4194304"

# Full D0 run: 80,729,939,067 active tokens occupy 80,731,963,392 token
# slots. The 2,024,325 terminal slots are loss-inactive; do not derive samples
# by flooring the active-token count.
TRAIN_TOKENS="${TRAIN_TOKENS:-80729939067}"
TRAIN_TOKEN_SLOTS="${TRAIN_TOKEN_SLOTS:-80731963392}"
LOSS_INACTIVE_TAIL_SLOTS="${LOSS_INACTIVE_TAIL_SLOTS:-2024325}"
TRAIN_SAMPLES="${TRAIN_SAMPLES:-19709952}"
TRAIN_ITERS="${TRAIN_ITERS:-19248}"
# The project selected a fixed 400-update warmup. It is intentionally not
# recomputed from beta2 after the beta2=0.999 sweep decision.
LR_WARMUP_ITERS="${LR_WARMUP_ITERS:-400}"
LR_WARMUP_TOKENS="${LR_WARMUP_TOKENS:-$(( LR_WARMUP_ITERS * GLOBAL_BATCH_TOKENS ))}"
# WSD cooldown policy: final 20% of training samples.
LR_WSD_DECAY_SAMPLES="${LR_WSD_DECAY_SAMPLES:-3942400}"
# AdEMAMix scheduler policy: beta3 half-life warmup and alpha linear warmup
# over the full run.
ADEMA_BETA3_WARMUP_STEPS="${ADEMA_BETA3_WARMUP_STEPS:-$TRAIN_ITERS}"
ADEMA_ALPHA_WARMUP_STEPS="${ADEMA_ALPHA_WARMUP_STEPS:-$TRAIN_ITERS}"

# Loss.
LOSS_OBJECTIVE="${LOSS_OBJECTIVE:-goldfish}"
GOLDFISH_K="50"
GOLDFISH_H="50"

# Data semantics.
RESET_ATTENTION_MASK="${RESET_ATTENTION_MASK:-1}"
RESET_POSITION_IDS="${RESET_POSITION_IDS:-1}"
EOD_MASK_LOSS="${EOD_MASK_LOSS:-1}"
CURRICULUM_ORDER_MODE="${CURRICULUM_ORDER_MODE:-randomized}"  # physical_order | randomized
# Training/RNG seed and frozen D0 pool-permutation seed are distinct.
DATA_SEED="${DATA_SEED:-20260609}"
MIX_SEED="${MIX_SEED:-20260801}"
DATALOADER_WORKERS="${DATALOADER_WORKERS:-4}"

# Architecture. (xIELU and QK-LayerNorm are hardcoded in the trainer and recorded
# in cpt.regime.json; only the values the trainer reads from env live here.)
MAIN_GRADS_DTYPE="fp32"
MIXED_PRECISION_FLAG="--bf16"
QKNORM_IMPL="apex"
NORMALIZATION="RMSNorm"
TENSOR_MODEL_PARALLEL_SIZE="2"
PIPELINE_MODEL_PARALLEL_SIZE="1"

# Positional geometry.
MAX_POSITION_EMBEDDINGS="${MAX_POSITION_EMBEDDINGS:-4096}"
ROTARY_BASE="${ROTARY_BASE:-500000}"
USE_ROPE_SCALING="${USE_ROPE_SCALING:-1}"
ROPE_SCALING_FACTOR="${ROPE_SCALING_FACTOR:-8.0}"
MAKE_VOCAB_SIZE_DIVISIBLE_BY="${MAKE_VOCAB_SIZE_DIVISIBLE_BY:-256}"

# Cadence.
# This is retained for the generic diagnostic harness. Production uses the
# exact checkpoint list in full_8b_mixed_cpt.json, not one uniform interval.
SAVE_INTERVAL="${SAVE_INTERVAL:-119}"
EXIT_INTERVAL="${EXIT_INTERVAL:-}"
RESUME_TRAINING="${RESUME_TRAINING:-0}"
DISABLE_SAVE="${DISABLE_SAVE:-0}"

# Generic launch defaults. These are not hyperparameters; tune them for the
# cluster, queue, budget, and target wall time. Use launch_profiles/*.env for
# validated deployment profiles.
PARTITION="${PARTITION:-}"
TIME_LIMIT="${TIME_LIMIT:-12:00:00}"
NODES="${NODES:-1}"
GPUS_PER_NODE="${GPUS_PER_NODE:-4}"
ACCOUNT="${ACCOUNT:-}"
UENV_IMAGE="${UENV_IMAGE:-}"
UENV_VIEW="${UENV_VIEW:-default}"
LAUNCH_MODE="${LAUNCH_MODE:-}"
if [ -z "$LAUNCH_MODE" ]; then
    if [ "$NODES" -gt 1 ]; then
        LAUNCH_MODE="torchrun"
    else
        LAUNCH_MODE="slurm"
    fi
fi
