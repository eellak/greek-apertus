# Validated Clariden 16-node launch profile.
#
# This file records the operational profile that made multi-node training work
# on Clariden. Kept separate from cpt.env: node count, walltime,
# partition/account, software image, and transport overrides should be
# reconsidered for each cluster and allocation.

# Resource shape. Tune NODES/TIME_LIMIT for queue pressure, budget, and target
# wall time. The training regime itself does not require exactly 16 nodes.
NODES="${NODES:-16}"
GPUS_PER_NODE="${GPUS_PER_NODE:-4}"
TIME_LIMIT="${TIME_LIMIT:-12:00:00}"
# Segment shape. EXIT_INTERVAL should be a multiple of SAVE_INTERVAL so each
# segment stops at a checkpoint boundary. Tune SEGMENTS/EXIT_INTERVAL with node
# count and observed iteration time.
# This legacy equal-length chain is useful for diagnostics only. The production
# D0 launcher consumes the six exact boundaries from full_8b_mixed_cpt.json.
SEGMENTS="${SEGMENTS:-4}"
EXIT_INTERVAL="${EXIT_INTERVAL:-952}"
PARTITION="${PARTITION:-normal}"
ACCOUNT="${ACCOUNT:-}"
UENV_IMAGE="${UENV_IMAGE:-pytorch/v2.9.1:v2}"
UENV_VIEW="${UENV_VIEW:-default}"

# Multi-node launch shape: start one Slurm task per node, then let torchrun
# spawn local GPU workers.
LAUNCH_MODE="${LAUNCH_MODE:-torchrun}"

# Slingshot/CXI runtime knobs only; they do not change model, optimizer, data,
# scheduler, or tokenizer semantics.
TRANSPORT_PROFILE="${TRANSPORT_PROFILE:-clariden_cxi}"
NCCL_NET="${NCCL_NET:-AWS Libfabric}"
NCCL_NET_GDR_LEVEL="${NCCL_NET_GDR_LEVEL:-PHB}"
NCCL_CROSS_NIC="${NCCL_CROSS_NIC:-1}"
NCCL_PROTO="${NCCL_PROTO:-^LL128}"
NCCL_NET_FORCE_FLUSH="${NCCL_NET_FORCE_FLUSH:-0}"

FI_CXI_DEFAULT_CQ_SIZE="${FI_CXI_DEFAULT_CQ_SIZE:-131072}"
FI_CXI_DEFAULT_TX_SIZE="${FI_CXI_DEFAULT_TX_SIZE:-16384}"
FI_CXI_DISABLE_HOST_REGISTER="${FI_CXI_DISABLE_HOST_REGISTER:-1}"
FI_CXI_RX_MATCH_MODE="${FI_CXI_RX_MATCH_MODE:-software}"
FI_MR_CACHE_MONITOR="${FI_MR_CACHE_MONITOR:-userfaultfd}"
FI_CXI_RDZV_GET_MIN="${FI_CXI_RDZV_GET_MIN:-0}"
FI_CXI_RDZV_THRESHOLD="${FI_CXI_RDZV_THRESHOLD:-0}"
FI_CXI_RDZV_EAGER_SIZE="${FI_CXI_RDZV_EAGER_SIZE:-0}"
FI_CXI_SAFE_DEVMEM_COPY_THRESHOLD="${FI_CXI_SAFE_DEVMEM_COPY_THRESHOLD:-16777216}"
