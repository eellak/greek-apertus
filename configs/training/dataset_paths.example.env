# Copy to dataset_paths.env or another *.local.env file and fill in local paths.
#
# Full-run data is the extension-tokenized full HPLT slice plus the full
# GlossAPI Greek slice and replay data. HPLT-only 5B slices are diagnostic
# inputs, not the full-run dataset.

APERTUS_BASE_HF="/path/to/apertus-8b-hf"
APERTUS_BASE_MEGATRON="/path/to/apertus-8b-megatron"
MEGATRON_LM_DIR="/path/to/Megatron-LM-Swiss-AI"

BASE_TOKENIZER_DIR="$APERTUS_BASE_HF"
EXT_TOKENIZER_DIR="/path/to/greek-apertus-tokenizer-extension"

BASE_DATA_PREFIX="/path/to/base-tokenized/megatron_text_document"
EXT_DATA_PREFIX="/path/to/extension-tokenized/megatron_text_document"
